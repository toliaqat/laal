# ---- Supabase ----
# Public (safe to ship in client apps)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Expo reads EXPO_PUBLIC_* at build time
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only — NEVER expose to clients. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Stripe (test mode) ----
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ---- Email (Resend) ----
RESEND_API_KEY=re_...
EMAIL_FROM=Laal <noreply@laal.app>

# ---- File storage: Cloudflare R2 (S3-compatible) ----
# From the Cloudflare dashboard: R2 → Manage R2 API Tokens (Object Read & Write).
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=laal-documents
