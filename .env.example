# ---- Supabase ----
# Public (safe to ship in client apps)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Expo reads EXPO_PUBLIC_* at build time
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only — NEVER expose to clients. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Web app ----
# Public origin of the web app (no trailing slash). Used to build OAuth callback
# redirects, Stripe success/cancel URLs, and every transactional email link.
# Defaults to http://localhost:3000 if unset — MUST be set in production, or
# users receive localhost links. e.g. https://laal.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Same origin for the Expo app — it hands donations off to the web Stripe
# Checkout at this URL. Also defaults to localhost; set it for real builds.
EXPO_PUBLIC_APP_URL=http://localhost:3000

# ---- Stripe (test mode) ----
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ---- Email (Resend) ----
RESEND_API_KEY=re_...
EMAIL_FROM=Laal <noreply@laal.app>

# ---- File storage: Cloudflare R2 (S3-compatible) ----
# From the Cloudflare dashboard: R2 → Manage R2 API Tokens (Object Read & Write).
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# Private bucket — verification documents (presigned reads only).
R2_BUCKET=laal-documents
# Public bucket — campaign cover images (world-readable). MUST be a different
# bucket from R2_BUCKET, with public access enabled.
R2_PUBLIC_BUCKET=laal-public
# Public origin that serves R2_PUBLIC_BUCKET (custom domain or *.r2.dev), no
# trailing slash. e.g. https://img.laal.app
R2_PUBLIC_BASE_URL=https://img.laal.app

# ---- Google OAuth (Supabase Google provider) ----
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=<web client id>.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=<ios client id>.apps.googleusercontent.com
