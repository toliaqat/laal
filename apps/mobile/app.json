{
  "expo": {
    "name": "Laal",
    "slug": "laal",
    "scheme": "laal",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.laal.app"
    },
    "android": {
      "package": "com.laal.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.963166979158-t92gv05ov270ieauqsskl3e1sh18ejhj"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
